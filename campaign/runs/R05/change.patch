 async function limitedJson(request){if(!request.headers.get('content-type')?.includes('application/json'))throw Error('Content-Type must be application/json');let size=0,parts=[];const reader=request.body?.getReader();if(!reader)throw Error('Missing body');while(true){const {done,value}=await reader.read();if(done)break;size+=value.byteLength;if(size>131072){await reader.cancel();throw Error('Maximum body 128 KiB');}parts.push(value);}const bytes=new Uint8Array(size);let offset=0;for(const p of parts){bytes.set(p,offset);offset+=p.byteLength;}return JSON.parse(new TextDecoder().decode(bytes));}
